{
  "functions": {
    "api/adminAEYWTF.js": {
      "includeFiles": "protected/**"
    }
  },
  "rewrites": [
    { "source": "/api/auth", "destination": "/api/adminAEYWTF" },
    { "source": "/api/me", "destination": "/api/adminAEYWTF" },
    { "source": "/api/admin", "destination": "/api/adminAEYWTF" },
    { "source": "/api/captcha", "destination": "/api/adminAEYWTF" },
    { "source": "/api/satProxy", "destination": "/api/adminAEYWTF" },
    { "source": "/login.html", "destination": "/login.html" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/api/adminAEYWTF?path=$1" }
  ]
}
